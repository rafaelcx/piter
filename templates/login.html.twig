<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Piter de Vries</title>
    <link rel="stylesheet" href="/assets/login.css">
</head>

<body>
    <div class="container">
        <h1>Piter de Vries</h1>
        <p>I'm your personal mentat. I organize, advise, and keep your life in order.</p>

        <form action="/services" method="get" class="form-container">
            <select name="user_uid" required>
                <option value="" disabled selected>Select your profile</option>
                {% for user in users %}
                    <option value="{{ user.uid|e }}">{{ user.name|e }}</option>
                {% endfor %}
            </select>
            <button type="submit">Go</button>
        </form>
    </div> 
</body>

</html>
